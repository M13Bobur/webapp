NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/faiza_cafe

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin credentials (seeded on first run)
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=Admin123!

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://your-domain.com
ADMIN_TELEGRAM_CHAT_ID=your-admin-chat-id-for-notifications

# CORS — frontend va admin ochilgan to'liq URL (ngrok bo'lsa https://xxx.ngrok-free.app)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Qo'shimcha: CORS_ORIGINS=https://app.ngrok-free.app,http://192.168.1.5:5173

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
